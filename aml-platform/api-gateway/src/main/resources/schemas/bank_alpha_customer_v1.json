{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "customerId": {
      "type": "string",
      "minLength": 5
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": ["customerId", "countryCode"]
}